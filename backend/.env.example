PORT=5000
NODE_ENV=development
MONGODB_URI_LOCAL=mongodb://127.0.0.1:27017/explorex
MONGODB_URI=mongodb+srv://<database-user>:<url-encoded-password>@<cluster-host>/explorex?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
GEMINI_API_KEY=replace-with-your-gemini-key
CLIENT_URL=http://localhost:5173